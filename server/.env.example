# Sao chép file này thành .env và điền giá trị thực

# Bắt buộc khi deploy — thay bằng chuỗi ngẫu nhiên dài 32+ ký tự
JWT_SECRET=your-secret-key-here

# URL của frontend (Vercel) — dùng để giới hạn CORS
# Để trống hoặc * nếu muốn cho phép tất cả (không khuyến khích production)
FRONTEND_URL=https://your-app.vercel.app

# Render tự set PORT — không cần điền khi deploy
# PORT=3001
